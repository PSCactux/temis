# Copy to .env. Models are "<provider>:<model>"; the default is fully local with Ollama.

# --- Fully local with Ollama (no key; `ollama pull qwen3:8b` first) ---
LLM_MODEL=ollama:qwen3:8b
LLM_FAST_MODEL=ollama:qwen3:8b

# --- Any OpenAI-compatible gateway (LiteLLM, vLLM, a local inference server...) ---
# OPENAI_API_KEY=anything-the-gateway-accepts
# OPENAI_BASE_URL=http://localhost:4000/v1
# LLM_MODEL=openai:<model name at the gateway>
# LLM_FAST_MODEL=openai:<model name at the gateway>

# --- Claude Code CLI on a subscription (no key; for evaluation on your own machine) ---
# LLM_MODEL=claude-cli:sonnet
# LLM_FAST_MODEL=claude-cli:haiku

# --- Anthropic ---
# ANTHROPIC_API_KEY=
# LLM_MODEL=anthropic:claude-sonnet-5-5
# LLM_FAST_MODEL=anthropic:claude-haiku-5-5

# --- Interface ---
# ASSISTANT_LANGUAGE=en        # en | es: the texts the code writes (sources, blocked replies, the path)

# --- Privacy ---
# PRIVACY_MODE=full          # off | identifiers | full (identifiers + names found by the fast model)

# --- Memory and documents ---
# EMBEDDING_MODEL=intfloat/multilingual-e5-large   # ~2.2 GB; lighter: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# DOCS_DIR=data/docs
# PROJECTS_DIR=data/projects
# QDRANT_URL=http://localhost:6333   # a Qdrant server instead of the embedded store

# --- Tools ---
# SEARCH_URL=http://localhost:8888   # SearXNG-style JSON search; without it, DuckDuckGo lite is scraped
# MAX_TOOL_TURNS=12
# COURT_REGION=CT              # region code in data/calendar/holidays.json for procedural deadlines
# LOCAL_HOLIDAYS=2026-09-24    # comma-separated local holidays of the court
# ALLOWED_COMMANDS=ls cat head tail wc grep find sort uniq diff cut tr stat file   # run_command, no shell

# --- Observability ---
# OTLP_ENDPOINT=http://localhost:6006/v1/traces   # Phoenix, or any OTLP/HTTP collector
# TRACE_CONTENT=false                              # keep (pseudonymised) prompts out of traces
